<Window x:Class="KeyDisp.App.Windows.EditHudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KeyDisp.App.Windows"
        WindowStyle="ToolWindow" Topmost="True" ShowInTaskbar="False"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize">
    <Window.Resources>
        <local:EnumToIntConverter x:Key="EnumToInt"/>
        <local:HexToBrushConverter x:Key="HexToBrush"/>
    </Window.Resources>
    <StackPanel Margin="14" Width="320">
        <TextBlock x:Name="HintText" TextWrapping="Wrap" FontSize="11"
                   Foreground="Gray" Margin="0,0,0,10"/>

        <CheckBox x:Name="HiddenCheck" FontSize="12" Margin="0,0,0,10"
                  IsChecked="{Binding HiddenOnCurrentScreen}"/>

        <ComboBox x:Name="StyleCombo" Margin="0,0,0,10"
                  SelectedIndex="{Binding KeyStyle, Converter={StaticResource EnumToInt}}"/>

        <DockPanel Margin="0,0,0,6">
            <TextBlock x:Name="SizeLabel" FontSize="12" Width="70" VerticalAlignment="Center"/>
            <Slider Minimum="0.5" Maximum="5.0" Value="{Binding DisplayScale}"/>
        </DockPanel>
        <DockPanel Margin="0,0,0,6">
            <TextBlock x:Name="RowsLabel" FontSize="12" Width="70" VerticalAlignment="Center"/>
            <Slider Minimum="1" Maximum="8" TickFrequency="1" IsSnapToTickEnabled="True"
                    Value="{Binding MaxRows}"/>
        </DockPanel>

        <CheckBox x:Name="StackCheck" FontSize="12" Margin="0,4,0,10"
                  IsChecked="{Binding StackFromTop}"/>

        <DockPanel Margin="0,0,0,10">
            <TextBlock x:Name="AlignLabel" FontSize="12" Width="70" VerticalAlignment="Center"/>
            <ComboBox x:Name="AlignCombo"
                      SelectedIndex="{Binding RowAlignment, Converter={StaticResource EnumToInt}}"/>
        </DockPanel>

        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock x:Name="TextColorLabel" FontSize="12" Width="50" VerticalAlignment="Center"/>
                <Border Width="18" Height="18" Margin="4,0" BorderBrush="Gray" BorderThickness="1"
                        Cursor="Hand" Tag="TextColorHex" MouseLeftButtonDown="OnSwatchClicked"
                        Background="{Binding TextColorHex, Converter={StaticResource HexToBrush}}"/>
                <TextBox FontSize="12" VerticalAlignment="Center"
                         Text="{Binding TextColorHex, UpdateSourceTrigger=PropertyChanged}"/>
            </DockPanel>
            <DockPanel Grid.Column="1">
                <TextBlock x:Name="KeyColorLabel" FontSize="12" Width="50" VerticalAlignment="Center"/>
                <Border Width="18" Height="18" Margin="4,0" BorderBrush="Gray" BorderThickness="1"
                        Cursor="Hand" Tag="KeyColorHex" MouseLeftButtonDown="OnSwatchClicked"
                        Background="{Binding KeyColorHex, Converter={StaticResource HexToBrush}}"/>
                <TextBox FontSize="12" VerticalAlignment="Center"
                         Text="{Binding KeyColorHex, UpdateSourceTrigger=PropertyChanged}"/>
            </DockPanel>
        </Grid>

        <CheckBox x:Name="BgCheck" FontSize="12" Margin="0,0,0,6"
                  IsChecked="{Binding BackgroundEnabled}"/>
        <DockPanel>
            <TextBlock x:Name="OpacityLabel" FontSize="12" Width="70" VerticalAlignment="Center"/>
            <Slider Minimum="0" Maximum="1" Value="{Binding BackgroundOpacity}"
                    IsEnabled="{Binding BackgroundEnabled}"/>
        </DockPanel>

        <Button x:Name="DoneButton" HorizontalAlignment="Right" MinWidth="80"
                Margin="0,12,0,0" IsDefault="True" Click="OnDone"/>
    </StackPanel>
</Window>
