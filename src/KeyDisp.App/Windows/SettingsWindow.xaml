<Window x:Class="KeyDisp.App.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KeyDisp.App.Windows"
        Width="480" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False">
    <Window.Resources>
        <local:EnumToIntConverter x:Key="EnumToInt"/>
        <local:HexToBrushConverter x:Key="HexToBrush"/>
        <Style TargetType="CheckBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="RowLabel">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Width" Value="110"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="DockPanel">
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>
    <TabControl Margin="8">
        <!-- 表示 -->
        <TabItem x:Name="DisplayTab">
            <StackPanel Margin="12">
                <DockPanel>
                    <TextBlock x:Name="HoldLabel" Style="{StaticResource RowLabel}"/>
                    <TextBlock FontSize="11" Width="36" VerticalAlignment="Center"
                               Text="{Binding HoldDuration, StringFormat={}{0:0.0}s}"/>
                    <Slider Minimum="0" Maximum="5" Value="{Binding HoldDuration}"/>
                </DockPanel>
                <DockPanel>
                    <TextBlock x:Name="FadeLabel" Style="{StaticResource RowLabel}"/>
                    <TextBlock FontSize="11" Width="36" VerticalAlignment="Center"
                               Text="{Binding FadeDuration, StringFormat={}{0:0.0}s}"/>
                    <Slider Minimum="0.1" Maximum="4" Value="{Binding FadeDuration}"/>
                </DockPanel>
                <CheckBox x:Name="TypingAnimCheck" IsChecked="{Binding TypingAnimation}"/>
                <CheckBox x:Name="StepReleaseCheck" IsChecked="{Binding StepModifierRelease}"/>
                <DockPanel>
                    <TextBlock x:Name="HoldJudgeLabel" Style="{StaticResource RowLabel}"/>
                    <TextBlock FontSize="11" Width="36" VerticalAlignment="Center"
                               Text="{Binding HoldJudgeDelay, StringFormat={}{0:0.0}s}"/>
                    <Slider Minimum="0.2" Maximum="2" Value="{Binding HoldJudgeDelay}"/>
                </DockPanel>
                <CheckBox x:Name="DragToMoveCheck" IsChecked="{Binding DragToMove}"/>
                <CheckBox x:Name="FollowCursorCheck" IsChecked="{Binding FollowCursorScreen}"/>
                <CheckBox x:Name="TopEdgeCheck" IsChecked="{Binding TopEdgeFreeze}"/>
                <CheckBox x:Name="HotCornerCheck" IsChecked="{Binding HotCornerHide}"/>
            </StackPanel>
        </TabItem>
        <!-- キー表記 -->
        <TabItem x:Name="LabelsTab">
            <StackPanel Margin="12">
                <CheckBox x:Name="ShowAllCheck" IsChecked="{Binding ShowAllKeys}"/>
                <CheckBox x:Name="CountRepeatsCheck" IsChecked="{Binding CountRepeats}"/>
                <CheckBox x:Name="DistinguishCaseCheck" IsChecked="{Binding DistinguishCase}"/>
                <CheckBox x:Name="KanaCheck" IsChecked="{Binding KanaDisplay}"/>
                <DockPanel>
                    <TextBlock x:Name="LabelStyleLabel" Style="{StaticResource RowLabel}"/>
                    <ComboBox x:Name="LabelStyleCombo" FontSize="12"
                              SelectedIndex="{Binding OSLabelStyle, Converter={StaticResource EnumToInt}}"/>
                </DockPanel>
                <CheckBox x:Name="JisABCCheck" IsChecked="{Binding JisABCLabels}"/>
                <CheckBox x:Name="GlobeCheck" IsChecked="{Binding GlobeOnImeKeys}"/>
                <CheckBox x:Name="PlusSeparatorCheck" IsChecked="{Binding PlusSeparator}"/>
                <CheckBox x:Name="PressOrderCheck" IsChecked="{Binding ModifierPressOrder}"/>
                <DockPanel>
                    <TextBlock x:Name="ArrowGroupLabel" Style="{StaticResource RowLabel}"/>
                    <ComboBox x:Name="ArrowGroupCombo" FontSize="12"
                              SelectedIndex="{Binding ArrowGrouping, Converter={StaticResource EnumToInt}}"/>
                </DockPanel>
            </StackPanel>
        </TabItem>
        <!-- デザイン -->
        <TabItem x:Name="DesignTab">
            <StackPanel Margin="12">
                <DockPanel>
                    <TextBlock x:Name="StyleLabel" Style="{StaticResource RowLabel}"/>
                    <ComboBox x:Name="StyleCombo" FontSize="12"
                              SelectedIndex="{Binding KeyStyle, Converter={StaticResource EnumToInt}}"/>
                </DockPanel>
                <DockPanel>
                    <TextBlock x:Name="ScaleLabel" Style="{StaticResource RowLabel}"/>
                    <TextBlock FontSize="11" Width="36" VerticalAlignment="Center"
                               Text="{Binding DisplayScale, StringFormat={}×{0:0.0}}"/>
                    <Slider Minimum="0.5" Maximum="5" Value="{Binding DisplayScale}"/>
                </DockPanel>
                <DockPanel>
                    <TextBlock x:Name="MaxRowsLabel" Style="{StaticResource RowLabel}"/>
                    <TextBlock FontSize="11" Width="36" VerticalAlignment="Center"
                               Text="{Binding MaxRows, StringFormat={}{0:0}}"/>
                    <Slider Minimum="1" Maximum="8" TickFrequency="1" IsSnapToTickEnabled="True"
                            Value="{Binding MaxRows}"/>
                </DockPanel>
                <CheckBox x:Name="StackTopCheck" IsChecked="{Binding StackFromTop}"/>
                <DockPanel>
                    <TextBlock x:Name="AlignLabel" Style="{StaticResource RowLabel}"/>
                    <ComboBox x:Name="AlignCombo" FontSize="12"
                              SelectedIndex="{Binding RowAlignment, Converter={StaticResource EnumToInt}}"/>
                </DockPanel>
                <DockPanel>
                    <TextBlock x:Name="TextColorLabel" Style="{StaticResource RowLabel}"/>
                    <Border Width="18" Height="18" Margin="0,0,4,0" BorderBrush="Gray" BorderThickness="1"
                            Cursor="Hand" Tag="TextColorHex" MouseLeftButtonDown="OnSwatchClicked"
                            Background="{Binding TextColorHex, Converter={StaticResource HexToBrush}}"/>
                    <TextBox FontSize="12" VerticalAlignment="Center"
                             Text="{Binding TextColorHex, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>
                <CheckBox x:Name="OutlineCheck" IsChecked="{Binding TextOutline}"/>
                <DockPanel>
                    <TextBlock x:Name="OutlineColorLabel" Style="{StaticResource RowLabel}"/>
                    <Border Width="18" Height="18" Margin="0,0,4,0" BorderBrush="Gray" BorderThickness="1"
                            Cursor="Hand" Tag="TextOutlineColorHex" MouseLeftButtonDown="OnSwatchClicked"
                            Background="{Binding TextOutlineColorHex, Converter={StaticResource HexToBrush}}"/>
                    <TextBox FontSize="12" VerticalAlignment="Center"
                             IsEnabled="{Binding TextOutline}"
                             Text="{Binding TextOutlineColorHex, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>
                <DockPanel>
                    <TextBlock x:Name="KeyColorLabel" Style="{StaticResource RowLabel}"/>
                    <Border Width="18" Height="18" Margin="0,0,4,0" BorderBrush="Gray" BorderThickness="1"
                            Cursor="Hand" Tag="KeyColorHex" MouseLeftButtonDown="OnSwatchClicked"
                            Background="{Binding KeyColorHex, Converter={StaticResource HexToBrush}}"/>
                    <TextBox FontSize="12" VerticalAlignment="Center"
                             Text="{Binding KeyColorHex, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>
                <CheckBox x:Name="BgCheck" IsChecked="{Binding BackgroundEnabled}"/>
                <DockPanel>
                    <TextBlock x:Name="OpacityLabel" Style="{StaticResource RowLabel}"/>
                    <Slider Minimum="0" Maximum="1" Value="{Binding BackgroundOpacity}"
                            IsEnabled="{Binding BackgroundEnabled}"/>
                </DockPanel>
                <DockPanel>
                    <TextBlock x:Name="CustomImageLabel" Style="{StaticResource RowLabel}"/>
                    <Button x:Name="BrowseButton" DockPanel.Dock="Right" MinWidth="60" Margin="4,0,0,0"
                            FontSize="12" Click="OnBrowseImage"/>
                    <TextBox FontSize="11" VerticalAlignment="Center"
                             Text="{Binding CustomImagePath, UpdateSourceTrigger=LostFocus}"/>
                </DockPanel>
            </StackPanel>
        </TabItem>
        <!-- マウス -->
        <TabItem x:Name="MouseTab">
            <StackPanel Margin="12">
                <CheckBox x:Name="ClickInDisplayCheck" IsChecked="{Binding ShowClickInKeyDisplay}"/>
                <CheckBox x:Name="KeyClickComboCheck" IsChecked="{Binding ShowKeyClickCombo}"/>
                <Separator Margin="0,4,0,8"/>
                <CheckBox x:Name="HighlightCheck" IsChecked="{Binding MouseHighlight}"/>
                <DockPanel>
                    <TextBlock x:Name="HighlightColorLabel" Style="{StaticResource RowLabel}"/>
                    <Border Width="18" Height="18" Margin="0,0,4,0" BorderBrush="Gray" BorderThickness="1"
                            Cursor="Hand" Tag="MouseColorHex" MouseLeftButtonDown="OnSwatchClicked"
                            Background="{Binding MouseColorHex, Converter={StaticResource HexToBrush}}"/>
                    <TextBox FontSize="12" VerticalAlignment="Center"
                             Text="{Binding MouseColorHex, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>
                <DockPanel>
                    <TextBlock x:Name="HighlightSizeLabel" Style="{StaticResource RowLabel}"/>
                    <Slider Minimum="30" Maximum="120" Value="{Binding MouseHighlightSize}"/>
                </DockPanel>
                <Separator Margin="0,4,0,8"/>
                <CheckBox x:Name="BigCursorCheck" IsChecked="{Binding BigCursor}"/>
                <DockPanel>
                    <TextBlock x:Name="BigCursorSizeLabel" Style="{StaticResource RowLabel}"/>
                    <Slider Minimum="32" Maximum="160" Value="{Binding BigCursorSize}"/>
                </DockPanel>
                <DockPanel>
                    <TextBlock x:Name="BigCursorColorLabel" Style="{StaticResource RowLabel}"/>
                    <Border Width="18" Height="18" Margin="0,0,4,0" BorderBrush="Gray" BorderThickness="1"
                            Cursor="Hand" Tag="BigCursorColorHex" MouseLeftButtonDown="OnSwatchClicked"
                            Background="{Binding BigCursorColorHex, Converter={StaticResource HexToBrush}}"/>
                    <TextBox FontSize="12" VerticalAlignment="Center"
                             Text="{Binding BigCursorColorHex, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>
                <TextBlock x:Name="BigCursorNote" FontSize="11" Foreground="Gray" TextWrapping="Wrap"/>
            </StackPanel>
        </TabItem>
        <!-- 一般 -->
        <TabItem x:Name="GeneralTab">
            <StackPanel Margin="12">
                <DockPanel>
                    <TextBlock x:Name="LanguageLabel" Style="{StaticResource RowLabel}"/>
                    <ComboBox x:Name="LanguageCombo" FontSize="12"
                              SelectedIndex="{Binding Language, Converter={StaticResource EnumToInt}}"/>
                </DockPanel>
                <CheckBox x:Name="LaunchAtLoginCheck" IsChecked="{Binding LaunchAtLogin}"/>
                <DockPanel>
                    <TextBlock x:Name="HotKeyLabel" Style="{StaticResource RowLabel}"/>
                    <TextBox x:Name="HotKeyBox" FontSize="12" IsReadOnly="True" Width="140"
                             HorizontalAlignment="Left"
                             PreviewMouseDown="OnHotKeyBoxClicked"
                             PreviewKeyDown="OnHotKeyBoxKeyDown"
                             LostFocus="OnHotKeyBoxLostFocus"/>
                </DockPanel>
                <TextBlock x:Name="HotKeyHint" FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                           Margin="0,0,0,12"/>
                <Separator Margin="0,0,0,8"/>
                <TextBlock x:Name="PrivacyNote" FontSize="11" Foreground="Gray" TextWrapping="Wrap"/>
            </StackPanel>
        </TabItem>
    </TabControl>
</Window>
