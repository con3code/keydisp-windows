<Window x:Class="KeyDisp.App.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KeyDisp Overlay"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        ResizeMode="NoResize" Width="620" Height="440">
    <!-- MVP: シンプルスタイルのみ。キーキャップ / カスタム画像 / アニメーションは Phase 3 -->
    <ItemsControl x:Name="Rows" Margin="16" VerticalAlignment="Bottom">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border CornerRadius="{Binding CornerRadius}"
                        Background="{Binding Background}"
                        Padding="{Binding RowPadding}"
                        Margin="{Binding RowMargin}"
                        HorizontalAlignment="{Binding RowAlignment}">
                    <TextBlock Text="{Binding DisplayText}"
                               FontFamily="Segoe UI" FontWeight="SemiBold"
                               FontSize="{Binding FontSize}"
                               Foreground="{Binding Foreground}"
                               TextWrapping="Wrap"
                               MaxWidth="{Binding MaxTextWidth}"/>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</Window>
